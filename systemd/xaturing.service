[Unit]
Description=XaTuring - digital wyrm crawler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bartmoss_server
WorkingDirectory=/home/bartmoss_server/xaturing
ExecStart=/usr/bin/python /home/bartmoss_server/xaturing/xaturing.py
Restart=always
RestartSec=10
TimeoutStopSec=30
MemoryMax=1G
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
