# XaTuring configuration — copy to .env and adjust per machine.
# Paths support ~ expansion.

# Where the animal keeps its memory (SQLite database).
DB_PATH=~/xaturing/memory.db

# Where errors and skipped/blocked URLs are logged.
LOG_PATH=~/xaturing/xaturing.log

# The starting waters — one URL per line, # for comments.
SEEDS_PATH=~/xaturing/seeds.txt
